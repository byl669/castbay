---
import Page from '../layouts/Page.astro';
import { CERT_SHA256 } from '../i18n';
import Changelog from '../components/Changelog.astro';
import TocPage from '../components/TocPage.astro';
import DesktopChangelog from '../components/DesktopChangelog.astro';
import { releases, desktopReleases } from '../releases';

const desktop = (await desktopReleases('en')).map((r) => ({ depth: 3, slug: `desktop-v${r.data.version}`, text: r.data.version }));
const entries = [{ depth: 2, slug: 'desktop', text: 'CastBay Desktop' }, ...desktop, { depth: 2, slug: 'android', text: 'Android' }, ...(await releases('en')).map((r) => ({ depth: 2, slug: `v${r.data.version}`, text: r.data.version }))];
---
<Page lang="en" page="changelog" title="Changelog – CastBay" description="What's new in each version of CastBay.">
<TocPage lang="en" entries={entries}>
  <Fragment slot="top">
    <h1>Changelog</h1>
    <p class="date" set:html={`What changed in each version. Download the latest from <a href="/apk">CastBay.apk</a>, or any version from the <a href="https://github.com/weenas/castbay/releases">releases page</a>. Follow new versions with <a href="/changelog.xml">RSS</a>.`}></p>
    <details class="verify">
      <summary>Verify your download</summary>
      <p>Each version below lists its APK's SHA-256. Compare it with the file you downloaded: <code>shasum -a 256 CastBay-1.0.79.apk</code> on a Mac or Linux, <code>certutil -hashfile CastBay-1.0.79.apk SHA256</code> on Windows. (<code>CastBay.apk</code>, the latest version, is the same file as its numbered one.)</p>
      <p>Every release is signed with the same certificate (CN=CastBay, O=weenas), whose SHA-256 fingerprint is <code>{CERT_SHA256}</code>. <code>apksigner verify --print-certs</code>, from the Android SDK, shows it. Android also refuses to update CastBay with an APK signed by any other.</p>
      <p>To go back to an older version, uninstall CastBay first (Android won't install an older version over a newer one), then install it. Your settings are cleared with it.</p>
    </details>
  </Fragment>
  <DesktopChangelog lang="en" />
  <h2 id="android">Android</h2>
  <Changelog lang="en" />
</TocPage>
</Page>
