{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CastBay Desktop",
  "version": "0.0.0",
  "identifier": "com.weenas.castbay.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CastBay Desktop",
        "width": 480,
        "height": 680,
        "minWidth": 420,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
