{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CastBay Desktop",
  "version": "0.1.3",
  "identifier": "com.weenas.castbay.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CastBay Desktop",
        "visible": false,
        "width": 540,
        "height": 660,
        "minWidth": 460,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src https://api.github.com https://cast.weenas.com"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
