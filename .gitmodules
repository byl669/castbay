[submodule "third_party/libplist"]
	path = third_party/libplist
	url = https://github.com/libimobiledevice/libplist.git
[submodule "third_party/UxPlay"]
	path = third_party/UxPlay
	url = https://github.com/FDH2/UxPlay.git
[submodule "third_party/alac"]
	path = third_party/alac
	url = https://github.com/macosforge/alac.git
[submodule "third_party/openssl"]
	path = third_party/openssl
	url = https://github.com/openssl/openssl.git
	shallow = true
[submodule "desktop/third_party/nv-codec-headers"]
	path = desktop/third_party/nv-codec-headers
	url = https://github.com/FFmpeg/nv-codec-headers.git
	shallow = true
[submodule "desktop/third_party/AMF"]
	path = desktop/third_party/AMF
	url = https://github.com/GPUOpen-LibrariesAndSDKs/AMF.git
	shallow = true
[submodule "desktop/third_party/x264"]
	path = desktop/third_party/x264
	url = https://code.videolan.org/videolan/x264.git
	shallow = true
[submodule "desktop/third_party/FFmpeg"]
	path = desktop/third_party/FFmpeg
	url = https://github.com/FFmpeg/FFmpeg.git
	shallow = true
